# ============================================================
# .env.example — placeholder names only, NO real values here.
# Copy this file to .env.local for local development.
# .env.local is gitignored and must never be committed.
# ============================================================

# ============================================================
# FRONTEND (Vite — VITE_* vars are baked into the browser bundle at build time)
# These are NON-SECRET public identifiers — safe to bake into the bundle.
# ============================================================

# LiveKit Development Token Server project ID (non-secret public identifier).
# Only needed for local dev; the production app uses VITE_API_BASE_URL instead.
# Obtain from: LiveKit Cloud → project → Settings → Development Token Server
VITE_LIVEKIT_TOKEN_SERVER_ID=your-token-server-id-here

# URL of the deployed Vercel backend (no trailing slash).
# In GitHub Actions, set this as a repository VARIABLE (not secret).
# Example: https://onground-call-centre-abc123.vercel.app
VITE_API_BASE_URL=https://your-vercel-deployment.vercel.app

# ============================================================
# BACKEND — Vercel serverless functions (api/*.ts)
# These MUST be set as Vercel environment variables (never in the repo).
# ============================================================

# LiveKit Cloud server URL (wss:// project URL, not a secret)
# Obtain from: LiveKit Cloud → project → Settings → Project URL
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API key — SECRET. Never commit or log.
# Obtain from: LiveKit Cloud → project → Settings → API Keys → Create
LIVEKIT_API_KEY=API_xxxxxxxxxxxxxxxx

# LiveKit API secret — SECRET. Never commit or log.
LIVEKIT_API_SECRET=your-livekit-api-secret-here

# Phone dialing access code — SECRET. You choose this value.
# The user must enter this in the web UI before a call is placed.
# Use a strong random string (20+ chars). Keep this private.
ACCESS_CODE=replace-with-strong-random-passphrase

# Comma-separated list of E.164 phone numbers you are allowed to call.
# Required by the Twilio trial (only verified numbers) and as a security
# safeguard. Example: +91XXXXXXXXXX,+1XXXXXXXXXX
ALLOWED_DESTINATIONS=+91XXXXXXXXXX

# Allowed frontend origin for CORS (no trailing slash).
# Production: https://keerthisingh12.github.io
# Localhost is always permitted in non-production Vercel environments.
ALLOWED_ORIGIN=https://keerthisingh12.github.io

# ============================================================
# SIP / TELEPHONY (Phase 3 — set in Vercel dashboard)
# ============================================================

# LiveKit SIP Outbound Trunk ID — created via `lk sip trunk create`.
# Obtain after Phase 3 trunk setup. Not a secret but not needed in the browser.
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxxxxxx

# Twilio Account SID — SECRET. Never commit or log.
# Not used directly by this backend (LiveKit holds the SIP credentials),
# but needed when creating/updating the trunk via the Twilio console.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token — SECRET. Never commit or log.
# TWILIO_AUTH_TOKEN=your-twilio-auth-token-here

# ============================================================
# AI AGENT (Phase 2 — set in LiveKit Cloud agent secrets)
# ============================================================

# LiveKit Inference API key — for STT, LLM, TTS via LiveKit Inference.
# Set in LiveKit Cloud agent hosting secrets, NOT in Vercel or this file.
# LIVEKIT_INFERENCE_API_KEY=your-livekit-inference-key
